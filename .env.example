# Database
# Local development only. In production use the hosted PostgreSQL URL from
# Render, Neon, Supabase, or another provider. Do not use localhost in Vercel.
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth
# Generate a long random value for every deployed environment.
NEXTAUTH_SECRET="replace-with-a-long-random-production-secret"
# Local development URL. Set this to the public HTTPS origin in Vercel/Render.
NEXTAUTH_URL="http://localhost:3000"

# General AI
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Qwen AI
GROQ_QWEN_API_KEY=""
GROQ_WEBSITE_MODEL="qwen/qwen3.8-27b"
GROQ_ASSISTANT_MODEL="qwen/qwen3.8-27b"

# OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="qwen/qwen3.8-27b:free"
# Set to "true" to mock AI responses for testing/dev
AI_MOCK="false"

# OAuth Providers (Optional)
# Google OAuth client ID
GOOGLE_CLIENT_ID=""
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=""
# Github OAuth client ID
GITHUB_ID=""
# Github OAuth client secret
GITHUB_SECRET=""

# One-click deployment providers (server-side only; never prefix with NEXT_PUBLIC_)
# Add these only to the trusted app server if its deployment actions must be enabled.
VERCEL_TOKEN=""
RENDER_API_KEY=""

# One-time server-side seed secret for the normal Jiya Sadaria account.
# Set this only while running the seed; never expose it to the browser or commit it.
# JIYA_SADARIA_INITIAL_PASSWORD=""

# Explicit local-only demo identity switch. Keep false in production.
DEMO_MODE="false"

# Email / SMTP (server-side only — never prefix with NEXT_PUBLIC_)
# Required for verification emails, password resets, and deployment notifications.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, use an App Password.
# SendGrid example: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM=""

# Application public URL used in email links.
# Dev: http://localhost:3000  |  Production: https://your-domain.com
APP_URL="http://localhost:3000"
