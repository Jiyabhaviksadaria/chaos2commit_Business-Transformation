# Database
# Connection string to the PostgreSQL database
DATABASE_URL="postgresql://user:password@localhost:5432/mydb?schema=public"

# NextAuth
# Secret used to sign the JWT tokens
NEXTAUTH_SECRET="your-super-secret-string-here"
# The canonical URL of your site
NEXTAUTH_URL="http://localhost:3000"

# AI Providers (Optional)
# API key for Groq
GROQ_API_KEY=""
# API key for Google Gemini
GEMINI_API_KEY=""
# Default model to use for Groq
GROQ_MODEL=""
# Default model to use for Gemini
GEMINI_MODEL=""
# Set to "true" to mock AI responses for testing/dev
AI_MOCK="false"

# OAuth Providers (Optional)
# Google OAuth client ID
GOOGLE_CLIENT_ID=""
# Google OAuth client secret
GOOGLE_CLIENT_SECRET=""
# Github OAuth client ID
GITHUB_ID=""
# Github OAuth client secret
GITHUB_SECRET=""
