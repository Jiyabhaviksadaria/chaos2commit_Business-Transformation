generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(cuid())
  email                   String?                  @unique
  name                    String?
  passwordHash            String?
  image                   String?
  locale                  String                   @default("en")
  role                    PlatformRole             @default(USER)
  /// Optional user-selected role in the user's company. Kept separate from
  /// the platform authorization role above for backward compatibility.
  companyRole             String?
  emailVerified           DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  isDemo                  Boolean                  @default(false)
  department              String?
  accounts                Account[]
  activityLogs            ActivityLog[]
  aiUsages                AiUsage[]
  approvalsRequested      Approval[]               @relation("RequestedBy")
  approvalsReviewed       Approval[]               @relation("Reviewer")
  chatSessions            ChatSession[]
  comments                Comment[]
  createdTeamConversations TeamConversation[]      @relation("CreatedTeamConversations")
  deliverableVersions     DeliverableVersion[]
  emailVerificationTokens EmailVerificationToken[]
  memberships             Membership[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  sentTeamMessages        TeamMessage[]            @relation("SentTeamMessages")
  sessions                Session[]
  teamConversationMemberships TeamConversationMember[] @relation("TeamConversationMemberships")
  teamMessageReactions    TeamMessageReaction[]    @relation("TeamMessageReactions")

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Hashed email verification tokens for the custom signup flow.
/// Raw token is sent by email; only the hash is stored. Single-use via usedAt.
model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Hashed password reset tokens. Raw token is sent by email; only the hash is stored.
/// Single-use via usedAt, expires after a limited window.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  creditBalance Int                 @default(30)
  plan          OrgPlan             @default(FREE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  logs          ActivityLog[]
  aiUsages      AiUsage[]
  transactions  CreditTransaction[]
  memberships   Membership[]
  workspaces    Workspace[]
}

model CreditTransaction {
  id             String       @id @default(cuid())
  organizationId String
  userId         String?
  amount         Int
  reason         String
  refType        String?
  refId          String?
  balanceAfter   Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([refId])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Workspace {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  projects          Project[]
  teamConversations TeamConversation[]
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model Project {
  id                    String            @id @default(cuid())
  workspaceId           String
  name                  String
  industry              String?
  businessGoal          String
  businessContext       String?
  status                ProjectStatus     @default(DRAFT)
  lifecycle             ProjectLifecycle  @default(IDEA)
  blueprintData         Json?
  language              String            @default("en")
  siteSlug              String?           @unique
  sitePublished         Boolean           @default(false)
  intakeUrl             String?
  detectedLanguage      String?
  readinessScore        Int               @default(0)
  digitalMaturity       Int               @default(0)
  aiReadiness           Int               @default(0)
  discoveryCompleteness Int               @default(0)
  vercelProjectId       String?
  vercelProductionUrl   String?
  vercelPreviewUrl      String?
  renderServiceId       String?
  renderUrl             String?
  gitRepository         String?
  gitBranch             String?
  backendMode           String            @default("NONE")
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  primaryLanguage       String            @default("en")
  supportedLanguages    String[]          @default(["en"])
  logs                  ActivityLog[]
  blueprintChanges      BlueprintChange[]
  chatSessions          ChatSession[]
  deliverables          Deliverable[]
  deployments           Deployment[]
  documents             Document[]
  records               GeneratedRecord[]
  intakeSources         IntakeSource[]
  workspace             Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectContext        ProjectContext?
  recommendations       Recommendation[]
  teamConversations     TeamConversation[]

  @@index([workspaceId])
}

model Deployment {
  id                   String   @id @default(cuid())
  projectId            String
  provider             String
  environment          String
  providerDeploymentId String?
  url                  String?
  status               String
  commitId             String?
  errorMessage         String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Document {
  id            String         @id @default(cuid())
  projectId     String
  filename      String
  mimeType      String
  sizeBytes     Int
  checksum      String?
  extractedText String?
  summary       String?
  entities      Json?
  metadata      Json?
  status        DocumentStatus @default(PENDING)
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, checksum])
}

model ChatSession {
  id        String          @id @default(cuid())
  projectId String?
  userId    String
  kind      ChatSessionKind
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  title     String          @default("New chat")
  messages  ChatMessage[]
  project   Project?        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([userId, kind, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      ChatRole
  content   String
  createdAt DateTime    @default(now())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

model IntakeSource {
  id            String           @id @default(cuid())
  projectId     String
  kind          IntakeSourceKind
  label         String
  url           String?
  mimeType      String?
  sizeBytes     Int?
  checksum      String?
  extractedText String?
  metadata      Json?
  status        DocumentStatus   @default(PENDING)
  error         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @default(now()) @updatedAt
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, kind])
  @@index([checksum])
}

/// A single persisted context assembled from every successful intake source.
/// All transformation stages read this same snapshot instead of re-ingesting
/// a URL or document independently.
model ProjectContext {
  id              String   @id @default(cuid())
  projectId       String   @unique
  sources         Json     @default("[]")
  extractedText   String
  businessContent String
  metadata        Json     @default("{}")
  sourceTypes     Json     @default("[]")
  answers         Json     @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GeneratedRecord {
  id          String   @id @default(cuid())
  projectId   String
  moduleKey   String
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, moduleKey])
}

model Deliverable {
  id               String               @id @default(cuid())
  projectId        String
  type             DeliverableType
  title            String
  currentVersionId String?
  status           DeliverableStatus    @default(DRAFT)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  approvals        Approval[]
  comments         Comment[]
  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         DeliverableVersion[]

  @@index([projectId])
}

model DeliverableVersion {
  id            String        @id @default(cuid())
  deliverableId String
  versionNumber Int
  content       Json
  source        VersionSource
  language      String
  aiUsageId     String?
  createdById   String?
  note          String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdBy     User?         @relation(fields: [createdById], references: [id])
  deliverable   Deliverable   @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@index([createdById])
  @@index([deliverableId, language, versionNumber])
}

model Comment {
  id            String      @id @default(cuid())
  deliverableId String
  authorId      String
  body          String
  resolved      Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  author        User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@index([authorId])
}

model Approval {
  id            String         @id @default(cuid())
  deliverableId String
  requestedById String
  reviewerId    String?
  status        ApprovalStatus @default(PENDING)
  note          String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deliverable   Deliverable    @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  requestedBy   User           @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewer      User?          @relation("Reviewer", fields: [reviewerId], references: [id])

  @@index([deliverableId])
  @@index([requestedById])
  @@index([reviewerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id             String       @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime     @default(now())
  actor          User?        @relation(fields: [actorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([projectId])
  @@index([actorId])
}

model AiUsage {
  id               String        @id @default(cuid())
  userId           String?
  organizationId   String?
  provider         String
  model            String
  task             String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int
  status           AiTaskStatus
  error            String?
  createdAt        DateTime      @default(now())
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user             User?         @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

model Recommendation {
  id            String               @id @default(cuid())
  projectId     String
  title         String
  description   String
  category      String
  impact        String
  actionType    String
  actionPayload Json?
  status        RecommendationStatus @default(PENDING)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  project       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model AiModelConfig {
  id            String   @id @default(cuid())
  provider      String
  modelName     String
  enabled       Boolean  @default(true)
  temperature   Float    @default(0.7)
  maxTokens     Int      @default(4096)
  creditCost    Int      @default(5)
  priorityOrder Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([provider, modelName])
}

model BlueprintChange {
  id          String                @id @default(cuid())
  projectId   String
  prompt      String
  summary     String
  delta       Json
  impact      Json
  riskLevel   String                @default("LOW")
  status      BlueprintChangeStatus @default(PENDING)
  createdById String?
  createdAt   DateTime              @default(now())
  appliedAt   DateTime?
  project     Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

enum PlatformRole {
  PLATFORM_ADMIN
  USER
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProjectLifecycle {
  IDEA
  UNDERSTANDING
  DISCOVERY
  REQUIREMENTS
  BLUEPRINT
  DESIGNING
  AWAITING_APPROVAL
  BUILDING
  TESTING
  READY_TO_DEPLOY
  DEPLOYING
  LIVE
  UPDATING
  OPTIMIZING
  FAILED
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

enum ChatSessionKind {
  DISCOVERY
  CONSULTANT
  COMPANION
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

enum DeliverableType {
  INTAKE_ANALYSIS
  SYSTEM_SPEC
  WEBSITE_SPEC
  REQUIREMENTS
  PROCESS_ANALYSIS
  GAP_ANALYSIS
  STAKEHOLDERS
  MATURITY
  SOLUTION_RECOMMENDATION
  ARCHITECTURE_HLD
  ARCHITECTURE_LLD
  PROCESS_MAP
  WIREFRAMES
  DATABASE_DESIGN
  API_DESIGN
  ESTIMATION
  ROADMAP
  RISKS
}

enum IntakeSourceKind {
  IDEA
  URL
  DOCUMENT
  EXISTING_SYSTEM
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  IMPLEMENTATION_READY
}

enum VersionSource {
  AI
  USER_EDIT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AiTaskStatus {
  SUCCESS
  FAILED
  FALLBACK
}

enum RecommendationStatus {
  PENDING
  APPLIED
  DISMISSED
}

enum BlueprintChangeStatus {
  PENDING
  APPROVED
  REJECTED
  APPLIED
  FAILED
}

enum TeamConversationType {
  CHANNEL
  DIRECT_MESSAGE
  GROUP
}

enum TeamMemberRole {
  ADMIN
  MEMBER
}

model TeamConversation {
  id            String                 @id @default(cuid())
  workspaceId   String
  projectId     String?
  type          TeamConversationType   @default(CHANNEL)
  name          String?
  description   String?
  isPrivate     Boolean                @default(false)
  createdById   String?
  lastMessageAt DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project       Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy     User?                  @relation("CreatedTeamConversations", fields: [createdById], references: [id], onDelete: SetNull)
  members       TeamConversationMember[]
  messages      TeamMessage[]

  @@index([workspaceId])
  @@index([workspaceId, type])
  @@index([projectId])
  @@index([lastMessageAt])
}

model TeamConversationMember {
  id             String           @id @default(cuid())
  conversationId String
  userId         String
  role           TeamMemberRole   @default(MEMBER)
  lastReadAt     DateTime         @default(now())
  joinedAt       DateTime         @default(now())

  conversation   TeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User             @relation("TeamConversationMemberships", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([conversationId])
}

model TeamMessage {
  id             String                @id @default(cuid())
  conversationId String
  senderId       String
  content        String                @db.Text
  editedAt       DateTime?
  deletedAt      DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  conversation   TeamConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User                  @relation("SentTeamMessages", fields: [senderId], references: [id], onDelete: Cascade)
  reactions      TeamMessageReaction[]

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([createdAt])
}

model TeamMessageReaction {
  id        String      @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime    @default(now())

  message   TeamMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User        @relation("TeamMessageReactions", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}
