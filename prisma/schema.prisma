generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PlatformRole {
  PLATFORM_ADMIN
  USER
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  passwordHash  String?
  image         String?
  locale        String    @default("en")
  role          PlatformRole @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  chatSessions       ChatSession[]
  deliverableVersions DeliverableVersion[]
  comments           Comment[]
  approvalsRequested Approval[] @relation("RequestedBy")
  approvalsReviewed  Approval[] @relation("Reviewer")
  notifications      Notification[]
  activityLogs       ActivityLog[]
  aiUsages           AiUsage[]
  
  @@index([email])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OrgPlan {
  FREE
  PRO
  ENTERPRISE
}

model Organization {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  creditBalance Int      @default(30)
  plan          OrgPlan  @default(FREE)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   Membership[]
  workspaces    Workspace[]
  logs          ActivityLog[]
  aiUsages      AiUsage[]
  transactions  CreditTransaction[]
}

model CreditTransaction {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  amount         Int
  reason         String
  refType        String?
  refId          String?
  balanceAfter   Int
  createdAt      DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([refId])
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}

model Membership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@index([userId])
}

model Workspace {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects     Project[]

  @@index([organizationId])
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model Project {
  id           String   @id @default(cuid())
  workspaceId  String
  name         String
  industry     String?
  businessGoal    String   @db.Text
  businessContext String?  @db.Text
  status          ProjectStatus @default(DRAFT)
  language        String   @default("en")
  siteSlug        String?  @unique
  sitePublished   Boolean  @default(false)
  intakeUrl       String?
  detectedLanguage String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace    Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  documents    Document[]
  intakeSources IntakeSource[]
  chatSessions ChatSession[]
  deliverables Deliverable[]
  logs         ActivityLog[]
  records      GeneratedRecord[]

  @@index([workspaceId])
}

enum DocumentStatus {
  PENDING
  READY
  FAILED
}

model Document {
  id            String   @id @default(cuid())
  projectId     String
  filename      String
  mimeType      String
  sizeBytes     Int
  extractedText String?  @db.Text
  summary       String?  @db.Text
  status        DocumentStatus @default(PENDING)
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

enum ChatSessionKind {
  DISCOVERY
  CONSULTANT
  COMPANION
}

model ChatSession {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  kind      ChatSessionKind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project  Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([projectId])
  @@index([userId])
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model ChatMessage {
  id            String   @id @default(cuid())
  sessionId     String
  role          ChatRole
  content       String   @db.Text
  createdAt     DateTime @default(now())
  
  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum DeliverableType {
  INTAKE_ANALYSIS
  SYSTEM_SPEC
  WEBSITE_SPEC
  REQUIREMENTS
  PROCESS_ANALYSIS
  GAP_ANALYSIS
  STAKEHOLDERS
  MATURITY
  SOLUTION_RECOMMENDATION
  ARCHITECTURE_HLD
  ARCHITECTURE_LLD
  PROCESS_MAP
  WIREFRAMES
  DATABASE_DESIGN
  API_DESIGN
  ESTIMATION
  ROADMAP
  RISKS
}

enum IntakeSourceKind {
  IDEA
  URL
  DOCUMENT
  EXISTING_SYSTEM
}

model IntakeSource {
  id            String   @id @default(cuid())
  projectId     String
  kind          IntakeSourceKind
  label         String
  extractedText String?
  status        DocumentStatus @default(PENDING) // reuse DocumentStatus enum
  error         String?
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GeneratedRecord {
  id          String   @id @default(cuid())
  projectId   String
  moduleKey   String
  data        Json
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, moduleKey])
}

enum DeliverableStatus {
  DRAFT
  IN_REVIEW
  APPROVED
}

model Deliverable {
  id               String   @id @default(cuid())
  projectId        String
  type             DeliverableType
  title            String
  currentVersionId String?
  status           DeliverableStatus @default(DRAFT)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project          Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions         DeliverableVersion[]
  comments         Comment[]
  approvals        Approval[]

  @@index([projectId])
}

enum VersionSource {
  AI
  USER_EDIT
}

model DeliverableVersion {
  id             String   @id @default(cuid())
  deliverableId  String
  versionNumber  Int
  content        Json
  source         VersionSource
  language       String
  aiUsageId      String?
  createdById    String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@index([createdById])
}

model Comment {
  id            String   @id @default(cuid())
  deliverableId String
  authorId      String
  body          String   @db.Text
  resolved      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([deliverableId])
  @@index([authorId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id            String   @id @default(cuid())
  deliverableId String
  requestedById String
  reviewerId    String?
  status        ApprovalStatus @default(PENDING)
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverable Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  requestedBy User        @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewer    User?       @relation("Reviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([deliverableId])
  @@index([requestedById])
  @@index([reviewerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String    @db.Text
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?
  actorId        String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([projectId])
  @@index([actorId])
}

enum AiTaskStatus {
  SUCCESS
  FAILED
  FALLBACK
}

model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  organizationId   String?
  provider         String
  model            String
  task             String
  promptTokens     Int?
  completionTokens Int?
  latencyMs        Int
  status           AiTaskStatus
  error            String?  @db.Text
  createdAt        DateTime @default(now())

  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
}
